{
  "name": "dsh-coopanion-pet",
  "version": "1.9.0",
  "type": "module",
  "description": "Coopanion desktop pet for DeepSeek Harness: a whale-girl mascot that speaks, moves and can be driven by the agent",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "mascot",
    "coopanion",
    "whale"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "lib",
    "desktop",
    "cordis.patch.yml",
    "assets",
    "locale",
    "icon.svg",
    "README.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    },
    "compatibility": {
      "dshReleases": {
        "0.2.0-rc.2": "compatible"
      },
      "note": "在 dsh 0.2.0-rc.2（web profile 与桌面端内嵌运行时）上完成安装、加载与端到端验收：桌宠渲染、拖拽、界面穿透、气泡、装扮、13 个 pet_* 工具闭环、设置面板、提示词注入、11 门语言、走路足迹、帧率三档、全局说话热键、对话栈、形象包沙箱与导入；**独立窗口（Electron 运行时）：真透明/鼠标穿透/置顶/跨屏、全局快捷键、右键菜单、托盘、独立聊天面板（与 DSH 主面板同批会话）**；语音识别与合成、CUA 审批按可选接缝接入（未装对应插件时安全跳过），控制台零错误。"
    }
  },
  "meta": {
    "title": "Coopanion 桌宠",
    "description": "住在界面下沿的桌宠：气泡说话、表情动作、走路，可拖动，能听懂 Agent 的指挥。形象取自 Coopanion。"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangquanqing/dsh-coopanion-pet.git"
  },
  "bugs": {
    "url": "https://github.com/wangquanqing/dsh-coopanion-pet/issues"
  },
  "homepage": "https://github.com/wangquanqing/dsh-coopanion-pet#readme",
  "license": "AGPL-3.0-or-later",
  "optionalDependencies": {
    "electron": "^44.7.0"
  }
}
